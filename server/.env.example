# ==========================================
# CHD 课表云端后台环境配置文件示例
# 复制本文件为 .env 并填写你的数据库参数 (若使用云端 MySQL):
# cp .env.example .env
# ==========================================

# 若不配置 MySQL 参数，系统将自动使用内置轻量 SQLite (零配置开箱即用)
# MYSQL_HOST=your-mysql-host.mysql.database.azure.com
# MYSQL_PORT=3306
# MYSQL_USER=your_username
# MYSQL_PASSWORD=your_password
# MYSQL_DB=aluminum_db
